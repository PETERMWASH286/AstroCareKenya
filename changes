# Create default earning types if they don't exist
def create_default_earning_types():
    default_earning_types = [
        {
            'name': 'Basic Salary',
            'code': 'BASIC',
            'description': 'Basic monthly salary',
            'is_taxable': True,
            'is_statutory': False,
            'is_recurring': True
        },
        {
            'name': 'Housing Allowance',
            'code': 'HOUSE_ALLOW',
            'description': 'Housing allowance',
            'is_taxable': True,
            'is_statutory': False,
            'is_recurring': True
        },
        {
            'name': 'Transport Allowance',
            'code': 'TRANS_ALLOW',
            'description': 'Transport allowance',
            'is_taxable': True,
            'is_statutory': False,
            'is_recurring': True
        },
        {
            'name': 'Other Allowance',
            'code': 'OTHER_ALLOW',
            'description': 'Other allowances',
            'is_taxable': True,
            'is_statutory': False,
            'is_recurring': True
        }
    ]
    
    for earning_data in default_earning_types:
        existing = EarningType.query.filter_by(code=earning_data['code']).first()
        if not existing:
            earning_type = EarningType(**earning_data)
            db.session.add(earning_type)
    
    db.session.commit()
    print("Default earning types created.")