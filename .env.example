# Flask Configuration
FLASK_CONFIG=development
SECRET_KEY=YOUR_SUPER_SECRET_KEY_GOES_HERE # Change this!
# For production, typically set these via environment variables in your hosting environment

# Database Configuration (MySQL Example)
# Replace with your MySQL credentials and database name
DATABASE_URL=mysql+pymysql://root:pass@localhost:3306/astrocare_db
DB_USER=root
DB_PASS=pass
DB_HOST=localhost
# JWT Configuration
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY_GOES_HERE # Change this!
DB_ROOT_URI=mysql+pymysql://root:pass@localhost:3306/

# Email Configuration
MAIL_SERVER=smtp.mailtrap.io # Example using Mailtrap for testing
MAIL_PORT=2525
MAIL_USE_TLS=True
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
ADMINS=admin@example.com

# Celery Configuration (Using Redis)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Other App Specific Configuration
# Example: ITEMS_PER_PAGE=20


# M-Pesa Configuration
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BUSINESS_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://5742-154-76-36-245.ngrok-free.app/patients/mpesa-callback
